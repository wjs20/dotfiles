[init]
    defaultBranch = main
[core]
    editor = nvim
    pager = delta
[delta]
    navigate = true
    light = false
[diff]
    colorMoved = default
[interactive]
	diffFilter = delta --color-only
[merge]
    tool = vimdiff
    conflictStyle = diff3
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    frag = magenta bold
    meta = yellow bold
    new = green bold
    old = red bold
    whitespace = red reverse
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[help]
    autoCorrect = immediate
[rerere]
    enabled = true
[user]
	email = you@example.com
	name = William Steele
[page]
	diff = delta
	show = delta
	log = delta
	blame = delta
	reflog = delta
[diff "jupyternotebook"]
	command = git-nbdiffdriver diff
[merge "jupyternotebook"]
	driver = git-nbmergedriver merge %O %A %B %L %P
	name = jupyter notebook merge driver
[difftool "nbdime"]
	cmd = git-nbdifftool diff \"$LOCAL\" \"$REMOTE\" \"$BASE\"
[difftool]
	prompt = false
[mergetool "nbdime"]
	cmd = git-nbmergetool merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[mergetool]
	prompt = false
